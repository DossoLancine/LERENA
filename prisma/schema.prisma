generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String?  @unique
  phone     String?  @unique
  password  String?
  image     String?
  role      String   @default("CLIENT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships        OrganizationMember[]
  tickets            Ticket[]
  appointments       Appointment[]
  agentSessions      ServiceSession[]     @relation("AgentSessions")
  favorites          Favorite[]
  notifications      Notification[]
  pushSubscriptions  PushSubscription[]
  shifts             Shift[]
  networkMemberships NetworkMember[]
}

model Organization {
  id              String   @id @default(cuid())
  name            String
  category        String
  description     String?
  address         String?
  city            String?
  lat             Float?
  lng             Float?
  phone           String?
  email           String?
  logo            String?
  isActive        Boolean  @default(true)
  tvVideoUrl      String?
  tvMode          String   @default("HYBRID")
  tvQueueDuration Int      @default(30)
  tvVideoDuration Int      @default(30)
  maxRadiusKm     Float    @default(10.0)
  requireGps      Boolean  @default(false)
  bookingMode     String   @default("QUEUE_ONLY") // Options: "QUEUE_ONLY", "APPOINTMENT_ONLY", "HYBRID"
  networkId       String?
  sectorId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  members      OrganizationMember[]
  branches     Branch[]
  favorites    Favorite[]
  promotions   Promotion[]
  appointments Appointment[]
  devices      Device[]
  setupLinks   DeviceSetupLink[]
  network      Network?             @relation(fields: [networkId], references: [id], onDelete: SetNull)
  sector       Sector?              @relation(fields: [sectorId], references: [id], onDelete: SetNull)
}

model OrganizationMember {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           String   @default("AGENT")
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model Branch {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  address        String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  services      Service[]
  queues        Queue[]
  businessHours BusinessHour[]
  counters      Counter[]
  shifts        Shift[]
  Appointment   Appointment[]
}

model Service {
  id             String   @id @default(cuid())
  branchId       String
  name           String
  description    String?
  avgDurationMin Int      @default(15)
  icon           String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  branch      Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tickets     Ticket[]
  sessions    ServiceSession[]
  Appointment Appointment[]
}

model Queue {
  id         String   @id @default(cuid())
  branchId   String
  name       String
  prefix     String   @default("A")
  status     String   @default("OPEN")
  currentNum Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  branch  Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tickets Ticket[]
}

model Ticket {
  id                String    @id @default(cuid())
  queueId           String
  serviceId         String
  userId            String?
  guestName         String?
  guestPhone        String?
  counterName       String? // guichet qui a appelé le ticket (nom affiché)
  counterId         String?
  queuedAt          DateTime  @default(now()) // entrée dans la file actuelle (change lors d'un transfert)
  recalledAt        DateTime? // dernier rappel : la TV annonce à nouveau le numéro
  notes             String? // note interne des agents, visible lors d'un transfert
  number            Int
  displayNum        String
  status            String    @default("WAITING")
  position          Int?
  priorityScore     Int       @default(1)
  npsScore          Int? // 1-5 stars, null if not yet rated
  claimedPromoTitle String?
  claimedPromoPrice String?
  createdAt         DateTime  @default(now())
  calledAt          DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  updatedAt         DateTime  @updatedAt

  queue             Queue              @relation(fields: [queueId], references: [id], onDelete: Cascade)
  service           Service            @relation(fields: [serviceId], references: [id])
  user              User?              @relation(fields: [userId], references: [id])
  session           ServiceSession?
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  counter           Counter?           @relation(fields: [counterId], references: [id], onDelete: SetNull)
  events            TicketEvent[]
}

model Promotion {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  description    String?
  imageUrl       String?
  price          String?
  claimsCount    Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model ServiceSession {
  id              String    @id @default(cuid())
  ticketId        String    @unique
  serviceId       String
  agentId         String
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  durationSeconds Int?
  waitSeconds     Int?
  dayOfWeek       Int?
  hour            Int?

  ticket  Ticket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])
  agent   User    @relation("AgentSessions", fields: [agentId], references: [id])
}

model BusinessHour {
  id        String  @id @default(cuid())
  branchId  String
  dayOfWeek Int
  openTime  String
  closeTime String
  isClosed  Boolean @default(false)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model Favorite {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  ticketId  String?
  type      String
  title     String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket Ticket? @relation(fields: [ticketId], references: [id])
}

// Abonnement aux notifications push d'un appareil, lié au ticket suivi
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String?
  ticketId  String?
  createdAt DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([ticketId])
}

model Appointment {
  id             String   @id @default(cuid())
  userId         String?
  guestName      String?
  guestPhone     String?
  organizationId String
  serviceId      String?
  branchId       String
  scheduledDate  DateTime
  status         String   @default("CONFIRMED")
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User?        @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  service      Service?     @relation(fields: [serviceId], references: [id])
}

// Code de vérification envoyé par SMS (ticket invité, PIN oublié)
model PhoneVerification {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  purpose   String // GUEST_TICKET | RESET_PIN
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone, purpose])
}

// Guichet physique d'une agence, et les services qu'il traite (vide = tous)
model Counter {
  id         String   @id @default(cuid())
  branchId   String
  name       String
  isActive   Boolean  @default(true)
  serviceIds String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  branch  Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tickets Ticket[]
  shifts  Shift[]

  @@unique([branchId, name])
}

// Historique d'un ticket : appel, rappel, transfert, pause, note… (suivi et audit)
model TicketEvent {
  id            String   @id @default(cuid())
  ticketId      String
  type          String // ISSUED | CALLED | RECALLED | SERVING | COMPLETED | ABSENT | CANCELLED | HELD | RESUMED | TRANSFERRED | NOTE | PRIORITY
  actorId       String?
  counterName   String?
  fromServiceId String?
  toServiceId   String?
  note          String?
  createdAt     DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

// Créneau de travail planifié : un agent, un jour, des heures et éventuellement un guichet
model Shift {
  id        String   @id @default(cuid())
  branchId  String
  userId    String
  counterId String?
  date      DateTime @db.Date
  startTime String // « 08:00 »
  endTime   String // « 12:30 »
  createdAt DateTime @default(now())

  branch  Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  counter Counter? @relation(fields: [counterId], references: [id], onDelete: SetNull)

  @@index([branchId, date])
}

// Écran TV ou borne d'accueil, appairé à un établissement par un code à 6 chiffres.
// Le jeton (token) reste sur l'appareil et lui sert d'identité, sans compte utilisateur.
model Device {
  id               String    @id @default(cuid())
  organizationId   String?
  type             String // TV | KIOSK
  name             String?
  token            String    @unique // empreinte SHA-256 du jeton : le jeton lui-même ne reste que sur l'appareil
  pairingCode      String?   @unique
  pairingExpiresAt DateTime?
  pairedAt         DateTime?
  lastSeenAt       DateTime?
  createdAt        DateTime  @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// Lien d'installation d'appareils : à usage unique, valable peu de temps, seule l'empreinte est stockée
model DeviceSetupLink {
  id             String    @id @default(cuid())
  organizationId String
  tokenHash      String    @unique
  expiresAt      DateTime
  usedAt         DateTime?
  deviceId       String?
  createdById    String?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

// Réseau d'établissements piloté par un administrateur d'organisation
model Network {
  id        String   @id @default(cuid())
  name      String
  sector    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizations Organization[]
  members       NetworkMember[]
}

// Accès à un réseau : ORG_ADMIN (pilotage) ou VIEWER (lecture seule : auditeurs, tutelles)
model NetworkMember {
  id        String   @id @default(cuid())
  networkId String
  userId    String
  role      String   @default("VIEWER")
  createdAt DateTime @default(now())

  network Network @relation(fields: [networkId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, networkId])
}

// Journal d'audit : qui a fait quoi, quand, sur quoi (actions sensibles et administration)
model AuditLog {
  id             String   @id @default(cuid())
  actorId        String?
  actorName      String?
  action         String
  targetType     String?
  targetId       String?
  organizationId String?
  details        String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([createdAt])
}

// Secteur d'activité (santé, banque, administration…) : géré par l'équipe ATTENDS, jamais écrit dans le code.
// Les services types servent de modèle à la création d'un établissement.
model Sector {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  icon        String   @default("building")
  color       String   @default("orange")
  services    Json     @default("[]") // [{ name, durationMin, prefix, icon }]
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizations Organization[]
}

// Réglages de la plateforme (une seule ligne) : pays, carte, mode démo
model PlatformConfig {
  id                 String   @id @default("default")
  appName            String   @default("ATTENDS")
  defaultCountryCode String   @default("+225")
  defaultCity        String?
  defaultLat         Float?
  defaultLng         Float?
  demoMode           Boolean  @default(false)
  updatedAt          DateTime @updatedAt
}
