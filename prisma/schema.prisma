generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String?   @unique
  phone              String?   @unique
  password           String?
  image              String?
  role               String    @default("CLIENT")
  // Sécurité du compte (P3)
  mustChangePassword Boolean   @default(false) // mot de passe provisoire à changer à la première connexion
  sessionVersion     Int       @default(0) // incrémenté pour déconnecter toutes les sessions
  twoFactorEnabled   Boolean   @default(false)
  twoFactorSecret    String? // secret TOTP chiffré
  twoFactorRecovery  String[]  @default([]) // empreintes des codes de secours
  lastLoginAt        DateTime?
  termsAcceptedAt    DateTime? // acceptation des CGU et de la politique de confidentialité
  termsVersion       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  memberships          OrganizationMember[]
  tickets              Ticket[]
  appointments         Appointment[]
  agentSessions        ServiceSession[]      @relation("AgentSessions")
  favorites            Favorite[]
  notifications        Notification[]
  pushSubscriptions    PushSubscription[]
  shifts               Shift[]
  networkMemberships   NetworkMember[]
  passwordResets       PasswordReset[]
  authSessions         AuthSession[]
  customers            Customer[]
  notificationSettings NotificationSettings?
}

model Organization {
  id                   String    @id @default(cuid())
  name                 String
  category             String
  description          String?
  address              String?
  city                 String?
  lat                  Float?
  lng                  Float?
  phone                String?
  email                String?
  logo                 String? // logo en data URL (256 px max, 150 Ko max)
  brandColor           String? // couleur de marque #rrggbb (forfaits avec couleurs personnalisées)
  isActive             Boolean   @default(true)
  tvVideoUrl           String?
  tvMode               String    @default("HYBRID")
  tvQueueDuration      Int       @default(30)
  tvVideoDuration      Int       @default(30)
  maxRadiusKm          Float     @default(10.0)
  requireGps           Boolean   @default(false)
  bookingMode          String    @default("QUEUE_ONLY") // Options: "QUEUE_ONLY", "APPOINTMENT_ONLY", "HYBRID"
  // Le visiteur peut-il choisir lui-même une priorité ? (par défaut non : elle s'attribue à l'accueil)
  visitorPriorityApp   Boolean   @default(false)
  visitorPriorityKiosk Boolean   @default(false)
  // SMS « bientôt votre tour » aux visiteurs sans notification push (coût par SMS : désactivé par défaut)
  smsTurnAlerts        Boolean   @default(false)
  apptMaxActive        Int       @default(2) // RDV à venir par personne
  apptCancelHours      Int       @default(2) // annulation / report possible jusqu'à N heures avant
  apptNoShowGraceMin   Int       @default(15) // absence notée N minutes après l'heure
  apptNoShowBlock      Int       @default(0) // 0 = jamais ; sinon blocage des réservations après N absences
  apptNoShowSms        Boolean   @default(true) // SMS au visiteur absent pour reprogrammer (forfaits avec suivis)
  networkId            String?
  sectorId             String?
  smsCredits           Int       @default(0) // SMS achetés en packs, consommés après le quota mensuel du forfait
  featuredUntil        DateTime? // « mise en avant » payée : en tête de la recherche jusqu'à cette date
  defaultVisitValue    Int? // valeur moyenne d'une visite en FCFA (argent perdu par les absences, valeur des clients)
  // Pilote : date de mise en service et mesures relevées sur place avant Lerena (pour le rapport avant / après)
  pilotStartedAt       DateTime?
  pilotBaselineWaitMin Int?
  pilotBaselineDaily   Int?
  pilotNotes           String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  members            OrganizationMember[]
  branches           Branch[]
  favorites          Favorite[]
  promotions         Promotion[]
  shopProducts       ShopProduct[]
  shopOrders         ShopOrder[]
  appointments       Appointment[]
  devices            Device[]
  setupLinks         DeviceSetupLink[]
  priorityCategories PriorityCategory[]
  closureDays        ClosureDay[]
  subscription       Subscription?
  invoices           Invoice[]
  smsLedger          SmsLedger[]
  customers          Customer[]
  customerTags       CustomerTag[]
  followUps          CustomerFollowUp[]
  campaigns          Campaign[]
  complaints         Complaint[]
  regions            Region[]
  customRoles        CustomRole[]
  network            Network?             @relation(fields: [networkId], references: [id], onDelete: SetNull)
  sector             Sector?              @relation(fields: [sectorId], references: [id], onDelete: SetNull)
}

model OrganizationMember {
  id             String    @id @default(cuid())
  userId         String
  organizationId String
  role           String    @default("AGENT") // classe d'accès : MANAGER | RECEPTION | AGENT (écrans autorisés)
  // Rôle détaillé (lib/access-catalog.ts) et périmètre : sites et régions ; les deux vides = tout l'établissement
  accessRole     String?
  customRoleId   String?
  siteIds        String[]  @default([])
  regionIds      String[]  @default([])
  expiresAt      DateTime? // accès temporaire : coupé automatiquement à cette date
  disabledAt     DateTime? // accès suspendu (revue des accès)
  createdAt      DateTime  @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model Branch {
  id                 String   @id @default(cuid())
  organizationId     String
  name               String
  address            String?
  city               String?
  lat                Float?
  lng                Float?
  phone              String?
  isActive           Boolean  @default(true)
  regionId           String?
  targetWaitMin      Int? // objectif d'attente moyenne (minutes)
  targetSatisfaction Float? // objectif de satisfaction (sur 5)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  region        Region?           @relation(fields: [regionId], references: [id], onDelete: SetNull)
  services      Service[]
  queues        Queue[]
  businessHours BusinessHour[]
  counters      Counter[]
  shifts        Shift[]
  Appointment   Appointment[]
  devices       Device[]
  setupLinks    DeviceSetupLink[]
  shopOrders    ShopOrder[]
}

model Service {
  id              String   @id @default(cuid())
  branchId        String
  name            String
  description     String?
  avgDurationMin  Int      @default(15)
  icon            String?
  apptCapacity    Int      @default(1) // rendez-vous en même temps sur un créneau
  apptLeadMin     Int      @default(60) // délai minimum avant un rendez-vous (minutes)
  apptHorizonDays Int      @default(14) // jusqu'à combien de jours à l'avance
  isActive        Boolean  @default(true)
  visitValue      Int? // valeur d'une visite de ce service en FCFA (sinon celle de l'établissement)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  branch      Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tickets     Ticket[]
  sessions    ServiceSession[]
  Appointment Appointment[]
}

model Queue {
  id         String   @id @default(cuid())
  branchId   String
  name       String
  prefix     String   @default("A")
  status     String   @default("OPEN")
  currentNum Int      @default(0)
  numDay     String? // jour (AAAA-MM-JJ) de la numérotation en cours : elle repart à 1 chaque jour
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  branch  Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tickets Ticket[]
}

model Ticket {
  id                String    @id @default(cuid())
  queueId           String
  serviceId         String
  userId            String?
  guestName         String?
  guestPhone        String?
  counterName       String? // guichet qui a appelé le ticket (nom affiché)
  counterId         String?
  queuedAt          DateTime  @default(now()) // entrée dans la file actuelle (change lors d'un transfert)
  recalledAt        DateTime? // dernier rappel : la TV annonce à nouveau le numéro
  notes             String? // note interne des agents, visible lors d'un transfert
  number            Int
  displayNum        String
  status            String    @default("WAITING")
  position          Int?
  priorityScore     Int       @default(1)
  priorityReason    String? // motif de priorité choisi parmi ceux de l'établissement (ex. « Femme enceinte »)
  npsScore          Int? // 1-5 stars, null if not yet rated
  npsComment        String? // commentaire du visiteur avec sa note
  npsReason         String? // motif choisi : WAIT | WELCOME | ERROR | CLEANLINESS | OTHER
  npsAt             DateTime?
  claimedPromoTitle String?
  claimedPromoPrice String?
  customerId        String? // fiche visiteur de l'établissement (CRM)
  createdAt         DateTime  @default(now())
  calledAt          DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  updatedAt         DateTime  @updatedAt

  queue             Queue              @relation(fields: [queueId], references: [id], onDelete: Cascade)
  service           Service            @relation(fields: [serviceId], references: [id])
  user              User?              @relation(fields: [userId], references: [id])
  session           ServiceSession?
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  counter           Counter?           @relation(fields: [counterId], references: [id], onDelete: SetNull)
  customer          Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  events            TicketEvent[]
  complaint         Complaint?

  @@index([customerId])
}

model Promotion {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  description    String?
  imageUrl       String?
  price          String?
  claimsCount    Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model ServiceSession {
  id              String    @id @default(cuid())
  ticketId        String    @unique
  serviceId       String
  agentId         String
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  durationSeconds Int?
  waitSeconds     Int?
  dayOfWeek       Int?
  hour            Int?

  ticket  Ticket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])
  agent   User    @relation("AgentSessions", fields: [agentId], references: [id])
}

model BusinessHour {
  id        String  @id @default(cuid())
  branchId  String
  dayOfWeek Int
  openTime  String
  closeTime String
  isClosed  Boolean @default(false)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model Favorite {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

// Centre de notifications (cloche) : une ligne par personne et par événement, regroupées par groupKey
model Notification {
  id             String    @id @default(cuid())
  userId         String
  ticketId       String?
  type           String // événement (voir lib/notification-events.ts)
  title          String
  body           String
  url            String? // page ouverte au clic
  organizationId String?
  groupKey       String? // notifications du même type regroupées (« 3 nouveaux rendez-vous »)
  count          Int       @default(1)
  isRead         Boolean   @default(false)
  readAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket Ticket? @relation(fields: [ticketId], references: [id])

  @@index([userId, isRead, updatedAt])
  @@index([userId, groupKey])
}

// Préférences de notification d'une personne : canaux par événement et heures de silence (heure d'Abidjan)
model NotificationSettings {
  userId    String   @id
  prefs     Json     @default("{}") // { [événement]: ["APP", "PUSH", "EMAIL", "WHATSAPP"] }
  quietFrom Int?     @default(21) // null = jamais de silence
  quietTo   Int?     @default(7)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Abonnement aux notifications push d'un appareil, lié au ticket suivi
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String?
  ticketId  String?
  createdAt DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([ticketId])
}

model Appointment {
  id              String    @id @default(cuid())
  userId          String?
  guestName       String?
  guestPhone      String?
  organizationId  String
  serviceId       String?
  branchId        String
  scheduledDate   DateTime
  status          String    @default("CONFIRMED")
  notes           String?
  source          String    @default("APP") // APP | GUEST | RECEPTION
  code            String?   @unique // code d'arrivée à 6 chiffres (borne, accueil)
  manageTokenHash String?   @unique // lien de gestion (report, annulation) : empreinte seulement
  reminderDayAt   DateTime?
  reminderHourAt  DateTime?
  checkedInAt     DateTime?
  ticketId        String?
  cancelledAt     DateTime?
  customerId      String? // fiche visiteur de l'établissement (CRM)
  seriesId        String? // rendez-vous récurrents créés ensemble
  noShowSmsAt     DateTime? // SMS « reprogrammer » envoyé après l'absence
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  user         User?        @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  service      Service?     @relation(fields: [serviceId], references: [id])

  @@index([customerId])
}

// Code de vérification envoyé par SMS (ticket invité, PIN oublié)
model PhoneVerification {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  purpose   String // GUEST_TICKET | RESET_PIN
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone, purpose])
}

// Guichet physique d'une agence, et les services qu'il traite (vide = tous)
model Counter {
  id         String   @id @default(cuid())
  branchId   String
  name       String
  isActive   Boolean  @default(true)
  serviceIds String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  branch  Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tickets Ticket[]
  shifts  Shift[]

  @@unique([branchId, name])
}

// Historique d'un ticket : appel, rappel, transfert, pause, note… (suivi et audit)
model TicketEvent {
  id            String   @id @default(cuid())
  ticketId      String
  type          String // ISSUED | CALLED | RECALLED | SERVING | COMPLETED | ABSENT | CANCELLED | HELD | RESUMED | TRANSFERRED | NOTE | PRIORITY
  actorId       String?
  counterName   String?
  fromServiceId String?
  toServiceId   String?
  note          String?
  createdAt     DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

// Créneau de travail planifié : un agent, un jour, des heures et éventuellement un guichet
model Shift {
  id        String   @id @default(cuid())
  branchId  String
  userId    String
  counterId String?
  date      DateTime @db.Date
  startTime String // « 08:00 »
  endTime   String // « 12:30 »
  createdAt DateTime @default(now())

  branch  Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  counter Counter? @relation(fields: [counterId], references: [id], onDelete: SetNull)

  @@index([branchId, date])
}

// Écran TV ou borne d'accueil, appairé à un établissement par un code à 6 chiffres.
// Le jeton (token) reste sur l'appareil et lui sert d'identité, sans compte utilisateur.
model Device {
  id               String    @id @default(cuid())
  organizationId   String?
  branchId         String? // site où se trouve l'appareil (TV, borne)
  type             String // TV | KIOSK
  name             String?
  token            String    @unique // empreinte SHA-256 du jeton : le jeton lui-même ne reste que sur l'appareil
  pairingCode      String?   @unique
  pairingExpiresAt DateTime?
  pairedAt         DateTime?
  lastSeenAt       DateTime?
  createdAt        DateTime  @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
}

// Motifs de priorité définis par chaque établissement (handicap, grossesse, urgence…).
// level : 2 = prioritaire, 3 = très prioritaire. selfService : le visiteur peut le choisir lui-même
// (application, borne) ; sinon seul l'accueil peut l'attribuer.
model PriorityCategory {
  id             String   @id @default(cuid())
  organizationId String
  label          String
  level          Int      @default(2)
  selfService    Boolean  @default(true)
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// Échecs de connexion récents, par identifiant et par adresse IP (blocage temporaire anti-force brute)
model LoginAttempt {
  id        String   @id @default(cuid())
  key       String // « id:<email ou téléphone> » ou « ip:<adresse> »
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// Lien de réinitialisation du mot de passe : à usage unique, 1 heure, seule l'empreinte est stockée
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Session de connexion (un appareil) : listée dans « Sécurité du compte », révocable à distance
model AuthSession {
  id         String    @id @default(cuid())
  userId     String
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Journal des SMS et e-mails envoyés (ou simulés tant qu'aucun fournisseur n'est branché)
model OutboundMessage {
  id             String   @id @default(cuid())
  channel        String // SMS | EMAIL | WHATSAPP
  to             String
  subject        String?
  body           String
  purpose        String // RESET_PASSWORD, OTP, TURN_SOON, APPOINTMENT_REMINDER…
  status         String // SENT | FAILED | SIMULATED
  provider       String?
  error          String?
  organizationId String?
  ticketId       String? // ticket concerné (évite d'envoyer deux fois la même alerte)
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([createdAt])
}

// Jours de fermeture (fériés, exceptionnels) : aucun rendez-vous ce jour-là
model ClosureDay {
  id             String   @id @default(cuid())
  organizationId String
  branchId       String? // null = tous les sites
  date           DateTime // jour (minuit UTC)
  label          String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, date])
}

// Tâches planifiées (rappels, absences) : dernière exécution, pour ne pas les lancer trop souvent
model JobRun {
  id        String   @id
  lastRunAt DateTime
}

// Lien d'installation d'appareils : à usage unique, valable peu de temps, seule l'empreinte est stockée
model DeviceSetupLink {
  id             String    @id @default(cuid())
  organizationId String
  branchId       String?
  tokenHash      String    @unique
  expiresAt      DateTime
  usedAt         DateTime?
  deviceId       String?
  createdById    String?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  Branch       Branch?      @relation(fields: [branchId], references: [id])

  @@index([organizationId, createdAt])
}

// Réseau d'établissements piloté par un administrateur d'organisation
model Network {
  id        String   @id @default(cuid())
  name      String
  sector    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizations Organization[]
  members       NetworkMember[]
}

// Accès à un réseau : ORG_ADMIN (pilotage) ou VIEWER (lecture seule : auditeurs, tutelles)
model NetworkMember {
  id        String   @id @default(cuid())
  networkId String
  userId    String
  role      String   @default("VIEWER")
  createdAt DateTime @default(now())

  network Network @relation(fields: [networkId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, networkId])
}

// Journal d'audit : qui a fait quoi, quand, sur quoi (actions sensibles et administration)
model AuditLog {
  id             String   @id @default(cuid())
  actorId        String?
  actorName      String?
  action         String
  targetType     String?
  targetId       String?
  organizationId String?
  details        String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([createdAt])
}

// Secteur d'activité (santé, banque, administration…) : géré par l'équipe ATTENDS, jamais écrit dans le code.
// Les services types servent de modèle à la création d'un établissement.
model Sector {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  icon        String   @default("building")
  color       String   @default("orange")
  services    Json     @default("[]") // [{ name, durationMin, prefix, icon }]
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizations Organization[]
}

// Réglages de la plateforme (une seule ligne) : pays, carte, mode démo
model PlatformConfig {
  id                  String   @id @default("default")
  appName             String   @default("Lerena")
  defaultCountryCode  String   @default("+225")
  defaultCity         String?
  defaultLat          Float?
  defaultLng          Float?
  demoMode            Boolean  @default(false)
  // Modèle économique (modifiable dans /admin/billing-settings)
  trialDays           Int      @default(30) // 0 = pas d'essai
  trialPlanId         String? // forfait pendant l'essai (par défaut : le forfait mis en avant)
  graceDays           Int      @default(7) // délai après échéance avant suspension
  paymentTermDays     Int      @default(15) // échéance des factures
  taxRate             Int      @default(0) // TVA en %
  invoicePrefix       String   @default("LER")
  companyName         String?
  companyAddress      String?
  companyTaxId        String? // NCC
  companyRccm         String?
  companyPhone        String?
  companyEmail        String?
  paymentInstructions String? // numéros Mobile Money, RIB… affichés sur les factures
  // Conformité (loi ivoirienne n° 2013-450) : durée avant anonymisation des données nominatives
  retentionMonths     Int      @default(12)
  dpoEmail            String? // contact « données personnelles » affiché dans la politique de confidentialité
  artciReference      String? // numéro de déclaration / autorisation ARTCI
  updatedAt           DateTime @updatedAt
}

// ---- Modèle économique : forfaits par site, abonnements, catalogue, factures ----

model Plan {
  id                String   @id @default(cuid())
  code              String   @unique
  name              String
  tagline           String?
  priceMonthly      Int? // FCFA HT par site et par mois ; vide = sur devis
  yearlyDiscountPct Int      @default(15)
  maxCounters       Int? // par site ; vide = illimité
  maxServices       Int?
  maxTicketsMonth   Int?
  smsIncluded       Int      @default(0) // par site et par mois
  features          String[]
  isPublic          Boolean  @default(true)
  isActive          Boolean  @default(true)
  highlight         Boolean  @default(false)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                 String    @id @default(cuid())
  organizationId     String    @unique
  planId             String
  status             String    @default("TRIAL") // TRIAL | ACTIVE | SUSPENDED | CANCELLED
  billingCycle       String    @default("MONTHLY") // MONTHLY | YEARLY
  customPricePerSite Int? // prix négocié (FCFA HT / site / mois)
  discountPct        Int       @default(0)
  trialEndsAt        DateTime?
  currentPeriodEnd   DateTime?
  suspendedAt        DateTime?
  cancelledAt        DateTime?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])
}

model Product {
  id            String   @id @default(cuid())
  kind          String // SMS_PACK | FEATURED | HARDWARE | SETUP | OTHER
  name          String
  description   String?
  price         Int // FCFA HT
  rentalMonthly Int? // matériel : location mensuelle
  smsQuantity   Int?
  featuredDays  Int?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Invoice {
  id             String    @id @default(cuid())
  number         String    @unique
  organizationId String
  kind           String    @default("SUBSCRIPTION") // SUBSCRIPTION | ORDER
  status         String    @default("SENT") // DRAFT | SENT | PAID | VOID
  periodStart    DateTime?
  periodEnd      DateTime?
  issuedAt       DateTime  @default(now())
  dueAt          DateTime
  paidAt         DateTime?
  subtotal       Int
  taxRate        Int       @default(0)
  tax            Int       @default(0)
  total          Int
  lines          Json // [{ label, qty, unitPrice, amount, productId?, smsQuantity?, featuredDays? }]
  notes          String?
  appliedAt      DateTime? // effets appliqués au paiement (période, SMS, mise en avant)
  createdById    String?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payments     Payment[]

  @@index([organizationId, issuedAt])
}

model Payment {
  id           String   @id @default(cuid())
  invoiceId    String
  amount       Int
  method       String // ORANGE_MONEY | MTN_MOMO | WAVE | MOOV_MONEY | BANK_TRANSFER | CASH | CHEQUE
  reference    String?
  receivedAt   DateTime @default(now())
  recordedById String?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model SmsLedger {
  id             String   @id @default(cuid())
  organizationId String
  delta          Int
  reason         String
  invoiceId      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ---- Surveillance ----

// Erreur regroupée par empreinte (même message au même endroit) : une ligne par problème, avec un compteur
model ErrorEvent {
  id          String    @id @default(cuid())
  fingerprint String    @unique
  source      String // SERVER | CLIENT
  message     String
  stack       String?
  path        String?
  count       Int       @default(1)
  firstSeen   DateTime  @default(now())
  lastSeen    DateTime  @default(now())
  resolvedAt  DateTime?
  notifiedAt  DateTime?

  @@index([lastSeen])
}

// Limite de débit des actions publiques (prise de ticket, réservation, codes…) : une ligne par action
model RateEvent {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// Prospect : demande de démonstration envoyée depuis la page Tarifs, suivie dans la console
model Lead {
  id           String   @id @default(cuid())
  contactName  String
  organization String
  sector       String?
  city         String?
  phone        String
  email        String?
  sites        Int?
  message      String?
  status       String   @default("NEW") // NEW | CONTACTED | DEMO | WON | LOST
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, createdAt])
}

// ---- CRM : fichier des visiteurs de chaque établissement ----
// Une fiche par visiteur et par établissement, reconnue par le compte Lerena ou le numéro de téléphone.
// Les compteurs sont recalculés à chaque ticket, rendez-vous, absence ou note (lib/customers.ts).

model Customer {
  id             String    @id @default(cuid())
  organizationId String
  phone          String? // format international (+225…)
  userId         String? // compte Lerena lié
  name           String?
  visits         Int       @default(0) // passages (tickets ni annulés ni absents)
  noShows        Int       @default(0) // absences : ticket « absent » ou rendez-vous non honoré
  ratingAvg      Float?
  lastRating     Int?
  firstSeenAt    DateTime  @default(now())
  lastVisitAt    DateTime? // dernier ticket
  lastSeenAt     DateTime  @default(now()) // dernière activité, rendez-vous à venir compris (relances, conservation)
  consentAt      DateTime? // accord pour recevoir des messages d'information
  consentChannel String? // APP | RECEPTION | IMPORT
  optedOutAt     DateTime? // « STOP » : ne veut plus de messages d'information
  unsubToken     String?   @unique // lien de désinscription court envoyé dans les campagnes
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user          User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  tickets       Ticket[]
  appointments  Appointment[]
  notes         CustomerNote[]
  tags          CustomerTagLink[]
  followUps     CustomerFollowUp[]
  campaignSends CampaignRecipient[]
  complaints    Complaint[]
  shopOrders    ShopOrder[]

  @@unique([organizationId, phone])
  @@unique([organizationId, userId])
  @@index([organizationId, lastSeenAt])
}

model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  authorId   String?
  authorName String
  text       String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
}

model CustomerTag {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  color          String   @default("#c2410c")
  createdAt      DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  links        CustomerTagLink[]

  @@unique([organizationId, name])
}

model CustomerTagLink {
  customerId String
  tagId      String
  createdAt  DateTime @default(now())

  customer Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag      CustomerTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([customerId, tagId])
  @@index([tagId])
}

// Suivi daté d'un visiteur (« rappeler pour le contrôle le 15 février »), avec rappel SMS facultatif au visiteur
model CustomerFollowUp {
  id             String    @id @default(cuid())
  organizationId String
  customerId     String
  dueDate        DateTime // jour du suivi (minuit UTC)
  title          String
  assignedToId   String?
  assignedToName String?
  smsReminder    Boolean   @default(false)
  smsSentAt      DateTime?
  status         String    @default("OPEN") // OPEN | DONE | CANCELLED
  doneAt         DateTime?
  doneByName     String?
  createdById    String?
  createdByName  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, dueDate])
  @@index([customerId])
}

// Campagne SMS vers des visiteurs ayant donné leur accord (segment, étiquette ou sélection)
model Campaign {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  body           String // avec variables {prénom}, {établissement}, {lien}, {service}, {date}
  target         Json // { segment?, tagId?, customerIds? }
  status         String    @default("SCHEDULED") // SCHEDULED | SENDING | SENT | CANCELLED
  scheduledAt    DateTime
  startedAt      DateTime?
  finishedAt     DateTime?
  recipients     Int       @default(0)
  sent           Int       @default(0)
  failed         Int       @default(0)
  skipped        Int       @default(0) // plus de SMS, accord retiré entre-temps
  unsubscribed   Int       @default(0)
  createdById    String?
  createdByName  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sends        CampaignRecipient[]

  @@index([status, scheduledAt])
  @@index([organizationId, createdAt])
}

model CampaignRecipient {
  id         String    @id @default(cuid())
  campaignId String
  customerId String?
  status     String    @default("PENDING") // PENDING | SENDING | SENT | FAILED | SKIPPED
  error      String?
  sentAt     DateTime?

  campaign Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([campaignId, status])
  @@index([customerId])
}

// Avis négatif à traiter (note de 2 étoiles ou moins, ou commentaire négatif) : appel, SMS, note, clôture avec motif
model Complaint {
  id                String    @id @default(cuid())
  organizationId    String
  ticketId          String    @unique
  customerId        String?
  rating            Int
  comment           String?
  reason            String? // motif donné par le visiteur
  status            String    @default("OPEN") // OPEN | CLOSED
  closeReason       String? // WAIT | WELCOME | ERROR | CLEANLINESS | OTHER : cause retenue par l'établissement
  resolution        String? // ce qui a été fait
  closedAt          DateTime?
  closedByName      String?
  overdueNotifiedAt DateTime? // rappel « non traité sous 48 h » envoyé
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket       Ticket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  customer     Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  events       ComplaintEvent[]

  @@index([organizationId, status, createdAt])
}

model ComplaintEvent {
  id          String   @id @default(cuid())
  complaintId String
  kind        String // NOTE | SMS | CALL | CLOSED | REOPENED
  text        String?
  authorName  String?
  createdAt   DateTime @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId, createdAt])
}

// Paire de fiches signalée comme doublon possible mais confirmée différente par l'établissement
model CustomerDuplicateIgnore {
  organizationId String
  customerA      String // le plus petit identifiant des deux
  customerB      String
  createdAt      DateTime @default(now())

  @@id([organizationId, customerA, customerB])
}

// Connecteur vers un service extérieur (e-mail, SMS, WhatsApp, push, IA, paiement, connexion), réglé depuis la console.
// Les clés sont chiffrées ; en mode SIMULATION rien ne part, tout est journalisé.
model Integration {
  kind       String    @id // EMAIL | SMS | WHATSAPP | PUSH | AI | PAYMENT | AUTH
  provider   String
  mode       String    @default("SIMULATION") // SIMULATION | LIVE
  settings   Json      @default("{}") // réglages non secrets (expéditeur, hôte, identifiants publics)
  secrets    String? // JSON chiffré (clés, mots de passe)
  lastTestAt DateTime?
  lastTestOk Boolean?
  lastError  String?
  updatedBy  String?
  updatedAt  DateTime  @updatedAt
}

// Région : regroupement de sites (directeur régional)
model Region {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branches     Branch[]

  @@unique([organizationId, name])
}

// Rôle sur mesure : copie d'un rôle de base avec ses propres droits
model CustomRole {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  baseRole       String
  permissions    String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
}

// Rapports et alertes de l'établissement : envois choisis, destinataires supplémentaires, seuils d'alerte
model ReportSettings {
  organizationId String   @id
  daily          Boolean  @default(false)
  weekly         Boolean  @default(true)
  monthly        Boolean  @default(true)
  extraEmails    String[] @default([])
  alerts         Json     @default("{}") // { waitHigh: { on, min }, queueLong: { on, max }, noCall: { on, min }, complaintBurst: { on, count } }
  updatedAt      DateTime @updatedAt
}

// Rapport archivé : chiffres par site figés pour la période (le total se recalcule selon le périmètre du lecteur)
model Report {
  id             String   @id @default(cuid())
  organizationId String
  kind           String // DAILY | WEEKLY | MONTHLY
  periodStart    DateTime
  periodEnd      DateTime
  data           Json
  createdAt      DateTime @default(now())

  @@unique([organizationId, kind, periodStart])
  @@index([organizationId, createdAt])
}

// Analyse avancée par l'IA (connecteur « IA ») : synthèse des avis anonymisés, conservée pour l'affichage
model AiInsight {
  id             String   @id @default(cuid())
  organizationId String
  scopeKey       String // « all » ou sites du lecteur, triés
  content        Json
  model          String?
  inputTokens    Int?
  outputTokens   Int?
  createdById    String?
  createdAt      DateTime @default(now())

  @@index([organizationId, scopeKey, createdAt])
}

// ---- Boutique de l'établissement (N7) ----
// Produits physiques, numériques ou services proposés pendant la réservation, l'attente ou après le passage.
// C'est l'établissement qui valide chaque commande : Demandée → Confirmée → Payée → Remise (ou Annulée, Remboursée).

model ShopProduct {
  id             String   @id @default(cuid())
  organizationId String
  type           String   @default("PHYSICAL") // PHYSICAL | DIGITAL | SERVICE
  name           String
  description    String?
  imageUrl       String? // lien https ou image réduite (data:)
  price          Int      @default(0) // FCFA, 0 = offert
  compareAtPrice Int? // prix barré (promotion)
  stock          Int? // vide = stock non suivi
  lowStockAt     Int?
  branchIds      String[] // vide = tous les sites
  serviceIds     String[] // vide = tous les services
  moments        String[] // BOOKING | WAITING | AFTER
  digitalContent String? // lien ou code envoyé après paiement (produit numérique)
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  views          Int      @default(0)
  adds           Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        ShopOrderItem[]

  @@index([organizationId, isActive])
}

model ShopOrder {
  id             String    @id @default(cuid())
  organizationId String
  branchId       String
  number         Int // numéro de commande et de reçu, propre à l'établissement
  status         String    @default("REQUESTED") // REQUESTED | CONFIRMED | PAID | DELIVERED | CANCELLED | REFUNDED
  total          Int
  moment         String // BOOKING | WAITING | AFTER
  ticketId       String?
  appointmentId  String?
  customerId     String?
  userId         String?
  paymentMethod  String?
  paidAt         DateTime?
  paidById       String? // membre de l'équipe qui a encaissé (vendeur)
  deliveredAt    DateTime?
  closedAt       DateTime?
  closedReason   String? // motif d'annulation ou de remboursement
  digitalSentAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer     Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items        ShopOrderItem[]
  events       ShopOrderEvent[]

  @@unique([organizationId, number])
  @@index([organizationId, status, createdAt])
  @@index([ticketId])
  @@index([appointmentId])
  @@index([customerId])
}

model ShopOrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String?
  name      String
  type      String
  unitPrice Int
  qty       Int
  amount    Int

  order   ShopOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product ShopProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([productId])
}

model ShopOrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  status    String
  actorId   String? // membre de l'équipe ; vide = le visiteur
  note      String?
  createdAt DateTime @default(now())

  order ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}
